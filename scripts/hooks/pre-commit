#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright 2026 Rizonesoft
# Refuse a commit that would turn CI's gates red: one that stages TODO changes while todo/implementation-plan.md
# is stale or the TODO graph is invalid, and one that stages TODO or inventory changes while
# design/inventory/COVERAGE.md is stale (D02 T01 §18: a new record, or a stamp that changes what is implemented).
# Enabled per clone with `git config core.hooksPath scripts/hooks` (AGENTS.md).
todo=
inventory=
git diff --cached --name-only -- todo/ | grep -q . && todo=1
git diff --cached --name-only -- design/inventory/ | grep -q . && inventory=1
[ -n "$todo$inventory" ] || exit 0

# The checks read the working tree, so what they read must be exactly what is being committed: nothing unstaged and
# nothing untracked, ignored files included, since the checks read those too. Both read the TODO graph, which reads
# the review receipts and findings the TODO files cite (docs/reviews/); the coverage check reads the inventory too.
for dir in todo/ docs/reviews/ design/inventory/; do
    if ! git diff --quiet -- "$dir" || [ -n "$(git ls-files --others -- "$dir")" ]; then
        echo "pre-commit: $dir has unstaged or untracked changes; stage them (or stash them) so the plan check sees what is committed" >&2
        exit 1
    fi
done

root=$(git rev-parse --show-toplevel) || exit 1
# The first interpreter that actually runs: on Windows `python3` can be the Microsoft Store stub.
python=
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "" >/dev/null 2>&1; then
        python=$candidate
        break
    fi
done
if [ -z "$python" ]; then
    echo "pre-commit: Python is needed to check the TODO graph" >&2
    exit 1
fi
if [ -n "$todo" ]; then
    if ! "$python" "$root/scripts/todo-graph.py" validate >/dev/null || ! "$python" "$root/scripts/todo-graph.py" plan --check; then
        echo "pre-commit: run 'python scripts/todo-graph.py plan --sync', stage todo/implementation-plan.md, and commit again" >&2
        exit 1
    fi
fi
if ! "$python" "$root/scripts/inventory-report.py" --check; then
    echo "pre-commit: run 'python scripts/inventory-report.py', stage design/inventory/COVERAGE.md, and commit again" >&2
    exit 1
fi
