{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rizonesoft:office:design:inventory:schema",
  "title": "Microsoft 365 parity inventory file",
  "description": "One inventory file: a JSON array of element records. Checked by scripts/check-inventory.py.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/record"
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "app",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(shell|word|excel|powerpoint|visio|project|outlook)(\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$",
          "description": "Stable dotted id whose first segment is the app, for example word.home.font.bold.",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noColon"
            }
          ],
          "maxLength": 200
        },
        "app": {
          "enum": [
            "shell",
            "word",
            "excel",
            "powerpoint",
            "visio",
            "project",
            "outlook"
          ]
        },
        "kind": {
          "enum": [
            "tab",
            "contextualTab",
            "group",
            "control",
            "backstagePage",
            "pane",
            "statusItem",
            "view",
            "region",
            "dialog",
            "dialogTab",
            "setting",
            "contextMenu",
            "menuItem",
            "miniToolbar",
            "shortcut",
            "command"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noHost"
            }
          ],
          "description": "the visible label, at least one non-space character",
          "maxLength": 200
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "description": "id of the containing record",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noColon"
            }
          ],
          "maxLength": 200
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "position among the parent's children"
        },
        "controlType": {
          "enum": [
            "button",
            "splitButton",
            "dropdown",
            "gallery",
            "galleryItem",
            "comboBox",
            "checkBox",
            "radioButton",
            "toggleButton",
            "spinner",
            "dialogLauncher",
            "menu",
            "dynamicMenu",
            "colorPicker",
            "editBox",
            "label",
            "separator",
            "box",
            "buttonGroup",
            "listBox",
            "slider"
          ]
        },
        "size": {
          "enum": [
            "large",
            "medium",
            "small"
          ]
        },
        "keytip": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noHost"
            }
          ],
          "pattern": "\\S",
          "maxLength": 16
        },
        "shortcut": {
          "type": "string",
          "minLength": 1,
          "description": "key chord, for example Ctrl+B, at least one non-space character",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noHost"
            }
          ],
          "pattern": "\\S",
          "maxLength": 64
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "id of the command or control a shortcut invokes",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noColon"
            }
          ],
          "maxLength": 200
        },
        "menuPath": {
          "type": "string",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noHost"
            }
          ],
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 500
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "description": "Pixels at 100 percent scaling, relative to the window client area.",
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "width": {
              "type": "integer",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "captureProfile": {
          "type": "string",
          "minLength": 1,
          "description": "profile id recorded in design/inventory/REFERENCE.md (checked by scripts/check-inventory.py)",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noColon"
            }
          ],
          "maxLength": 64
        },
        "behaviour": {
          "type": "string",
          "minLength": 1,
          "description": "one sentence in our own words on what the element does; never quoted product text",
          "pattern": "^\\s*\\S",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noHost"
            }
          ],
          "maxLength": 1000
        },
        "idMso": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noColon"
            }
          ],
          "pattern": "^[A-Za-z0-9_]+$",
          "maxLength": 200,
          "description": "Office control identifier (idMso): ASCII letters, digits and underscores only"
        },
        "uiaId": {
          "type": "string",
          "minLength": 1,
          "description": "UI Automation AutomationId: printable ASCII, single spaces between words",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noColon"
            }
          ],
          "pattern": "^[!-~]+( [!-~]+)*$",
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "pattern": "^((uia|listcommands):[0-9]+(\\.[0-9]+){3}|baseline:[0-9a-f]{7,40})$",
          "description": "Capture provenance: uia: or listcommands: followed by the Office build, or baseline: followed by the baseline commit. Records never cite web pages.",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            }
          ],
          "maxLength": 100
        },
        "capturedFrom": {
          "type": "string",
          "minLength": 1,
          "description": "Office build recorded in design/inventory/REFERENCE.md, for example 16.0.20430.20182 (checked by scripts/check-inventory.py)",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noColon"
            }
          ],
          "maxLength": 64
        },
        "baselineMissing": {
          "type": "boolean",
          "description": "true when the live build shows it but the 2024 baseline lacks it"
        }
      },
      "dependentRequired": {
        "bounds": [
          "captureProfile"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "control"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "controlType",
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "shortcut"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "shortcut"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "pattern": "^(uia|listcommands):[0-9]+(\\.[0-9]+){3}$"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "capturedFrom"
            ]
          }
        }
      ],
      "description": "Every string field has a maxLength (at most 1000 characters, for a behaviour sentence), which also bounds the time the link and address patterns take."
    },
    "noLink": {
      "description": "Owner rule 2026-10-20: no record holds a web address. In every string field: a scheme followed by ://, a network path (two slashes, or two backslashes, followed by a host), a scheme followed by a single slash or backslash (which URL parsers still resolve to the address), a mailto: address, a www. name, a dotted host followed by a path, or a name ending in .com, .org, .net, .gov or .edu. Text a person reads is held to the stricter noHost rule as well.",
      "not": {
        "pattern": "[A-Za-z][A-Za-z0-9+.-]*://|[Ww][Ww][Ww]\\.|[Mm][Aa][Ii][Ll][Tt][Oo]:|[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+/|[A-Za-z0-9-]+\\.([Cc][Oo][Mm]|[Oo][Rr][Gg]|[Nn][Ee][Tt]|[Gg][Oo][Vv]|[Ee][Dd][Uu])(?![A-Za-z0-9-])|[\\\\/][\\\\/][^\\s\\\\/]|[A-Za-z][A-Za-z0-9+.-]*:[\\\\/]",
        "description": "link"
      }
    },
    "noControl": {
      "description": "No control character and no invisible format character in any string, and nothing outside the Basic Multilingual Plane. The class is every BMP character Unicode (16.0.0) classes as a control (Cc) or format (Cf) character, such as the byte order mark, zero-width spaces and joiners, the soft hyphen, bidi controls and the interlinear annotation controls, plus the other default-ignorable code points (variation selectors, Hangul fillers), which URL and IDNA processing drop, so they could hide an address or pass for text. Characters outside the BMP (emoji, tags, supplementary variation selectors) are refused in both regular expression modes: the surrogate range catches them as code units without the u flag, and a negated class of the whole BMP catches them as code points with it. No Office text needs any of these.",
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u115F-\\u1160\\u17B4-\\u17B5\\u180B-\\u180F\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u206F\\u3164\\uFE00-\\uFE0F\\uFEFF\\uFFA0\\uFFF0-\\uFFFB\\uD800-\\uDFFF]|[^\\u0000-\\uFFFF]",
        "description": "control character (or an invisible one)"
      }
    },
    "noHost": {
      "description": "No address of any kind in text a person reads (label, keytip, shortcut, menuPath, behaviour). A full stop (any character whose compatibility form is or contains a full stop (U+2488 is 1. and U+2026 is ...), such as the one dot leader U+2024, the small full stop U+FE52 and the fullwidth full stop, plus the ideographic and halfwidth full stops IDNA treats as separators) may be followed only by whitespace, another full stop, closing punctuation, the end of the text, or a digit when a digit precedes it, as in a decimal such as 1.5. That refuses every host name, in any script and punycode included, whatever its letters. Three or more dotted numbers (an IPv4 address, shorthand such as 127.0.1 included; a two-part number such as 1.5 is a decimal and stays valid, though resolvers also read it as an address), an IPv6 address (a :: between hexadecimal groups, or four or more hexadecimal groups joined by colons; a time such as 12:30:45, with three groups, stays valid) and a word followed directly by a colon (any character whose compatibility form is or contains a colon) and a non-space character (any URI scheme) are refused too. Office's own labels have none of these; abbreviations with inner dots are refused as well, so write \"for example\", not \"e.g.\". Identifier fields carry noLink and noColon instead, since ids are dotted; source keeps its own anchored pattern, whose colon is part of the format. Any compatibility character whose normalised form holds a visible ASCII character (fullwidth letters and digits, circled and superscript numbers, ligatures, U+33C2 which is a.m., U+2488 which is 1.) is refused outright, since its normalised form can spell an address its raw spelling does not show; only the ellipsis U+2026 stays, under the full stop rules. A hexadecimal number (0x...) beside a full stop is refused too, since an IPv4 parser reads 127.0x0.1 as an address.",
      "not": {
        "pattern": "[\\u00aa\\u00b2-\\u00b3\\u00b9-\\u00ba\\u00bc-\\u00be\\u0132-\\u0133\\u013f-\\u0140\\u0149\\u017f\\u01c4-\\u01cc\\u01f1-\\u01f3\\u02b0\\u02b2-\\u02b3\\u02b7-\\u02b8\\u02e1-\\u02e3\\u037e\\u1d2c\\u1d2e\\u1d30-\\u1d31\\u1d33-\\u1d3a\\u1d3c\\u1d3e-\\u1d43\\u1d47-\\u1d49\\u1d4d\\u1d4f-\\u1d50\\u1d52\\u1d56-\\u1d58\\u1d5b\\u1d62-\\u1d65\\u1d9c\\u1da0\\u1dbb\\u1e9a\\u1fef\\u2024-\\u2025\\u203c\\u2047-\\u2049\\u2070-\\u2071\\u2074-\\u207a\\u207c-\\u208a\\u208c-\\u208e\\u2090-\\u2093\\u2095-\\u209c\\u20a8\\u2100-\\u2103\\u2105-\\u2106\\u2109-\\u210e\\u2110-\\u2113\\u2115-\\u2116\\u2119-\\u211d\\u2120-\\u2122\\u2124\\u2128\\u212a\\u212c-\\u212d\\u212f-\\u2131\\u2133-\\u2134\\u2139\\u213b\\u2145-\\u2149\\u2150-\\u217f\\u2189\\u2460-\\u24ea\\u2a74-\\u2a76\\u2c7c-\\u2c7d\\u3200-\\u321e\\u3220-\\u3243\\u3250-\\u325f\\u32b1-\\u32cf\\u3358-\\u337a\\u3380-\\u33ff\\ua7f2-\\ua7f4\\ufb00-\\ufb06\\ufb29\\ufe10\\ufe13-\\ufe16\\ufe19\\ufe30\\ufe33-\\ufe38\\ufe47-\\ufe48\\ufe4d-\\ufe50\\ufe52\\ufe54-\\ufe57\\ufe59-\\ufe5c\\ufe5f-\\ufe66\\ufe68-\\ufe6b\\uff01-\\uff5e]|0[xX][0-9A-Fa-f]*[.\\u2024\\u2025\\u2026\\u2488\\u2489\\u248a\\u248b\\u248c\\u248d\\u248e\\u248f\\u2490\\u2491\\u2492\\u2493\\u2494\\u2495\\u2496\\u2497\\u2498\\u2499\\u249a\\u249b\\u3002\\u33c2\\u33c7\\u33d8\\ufe19\\ufe30\\ufe52\\uff0e\\uff61]|[.\\u2024\\u2025\\u2026\\u2488\\u2489\\u248a\\u248b\\u248c\\u248d\\u248e\\u248f\\u2490\\u2491\\u2492\\u2493\\u2494\\u2495\\u2496\\u2497\\u2498\\u2499\\u249a\\u249b\\u3002\\u33c2\\u33c7\\u33d8\\ufe19\\ufe30\\ufe52\\uff0e\\uff61]0[xX]|[.\\u2024\\u2025\\u2026\\u2488\\u2489\\u248a\\u248b\\u248c\\u248d\\u248e\\u248f\\u2490\\u2491\\u2492\\u2493\\u2494\\u2495\\u2496\\u2497\\u2498\\u2499\\u249a\\u249b\\u3002\\u33c2\\u33c7\\u33d8\\ufe19\\ufe30\\ufe52\\uff0e\\uff61](?![\\s.\\u2024\\u2025\\u2026\\u2488\\u2489\\u248a\\u248b\\u248c\\u248d\\u248e\\u248f\\u2490\\u2491\\u2492\\u2493\\u2494\\u2495\\u2496\\u2497\\u2498\\u2499\\u249a\\u249b\\u3002\\u33c2\\u33c7\\u33d8\\ufe19\\ufe30\\ufe52\\uff0e\\uff61)\\]\"'\\u201d\\u2019]|\\d|$)|(?<![0-9])[.\\u2024\\u2025\\u2026\\u2488\\u2489\\u248a\\u248b\\u248c\\u248d\\u248e\\u248f\\u2490\\u2491\\u2492\\u2493\\u2494\\u2495\\u2496\\u2497\\u2498\\u2499\\u249a\\u249b\\u3002\\u33c2\\u33c7\\u33d8\\ufe19\\ufe30\\ufe52\\uff0e\\uff61](?=\\d)|\\d+[.\\u2024\\u2025\\u2026\\u2488\\u2489\\u248a\\u248b\\u248c\\u248d\\u248e\\u248f\\u2490\\u2491\\u2492\\u2493\\u2494\\u2495\\u2496\\u2497\\u2498\\u2499\\u249a\\u249b\\u3002\\u33c2\\u33c7\\u33d8\\ufe19\\ufe30\\ufe52\\uff0e\\uff61]\\d+[.\\u2024\\u2025\\u2026\\u2488\\u2489\\u248a\\u248b\\u248c\\u248d\\u248e\\u248f\\u2490\\u2491\\u2492\\u2493\\u2494\\u2495\\u2496\\u2497\\u2498\\u2499\\u249a\\u249b\\u3002\\u33c2\\u33c7\\u33d8\\ufe19\\ufe30\\ufe52\\uff0e\\uff61]\\d+|[A-Za-z][A-Za-z0-9+.-]*[:\\u2a74\\ufe13\\ufe55\\uff1a]\\S|[0-9A-Fa-f]{0,4}[:\\u2a74\\ufe13\\ufe55\\uff1a][:\\u2a74\\ufe13\\ufe55\\uff1a][0-9A-Fa-f]{0,4}|[0-9A-Fa-f]{1,4}([:\\u2a74\\ufe13\\ufe55\\uff1a][0-9A-Fa-f]{1,4}){3,}",
        "description": "host name or address"
      }
    },
    "noColon": {
      "description": "No colon in an identifier field (id, parent, target, captureProfile, capturedFrom, idMso, uiaId): none holds one, and a scheme followed by a colon is how every address begins, with slashes or without (https:localhost resolves too). source keeps its own anchored pattern, whose colon is part of the format.",
      "not": {
        "pattern": "[:\\uff1a]",
        "description": "colon"
      }
    }
  }
}
