{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rizonesoft:office:design:inventory:schema",
  "title": "Microsoft 365 parity inventory file",
  "description": "One inventory file: a JSON array of element records. Checked by scripts/check-inventory.py.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/record"
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "app",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(shell|word|excel|powerpoint|visio|project|outlook)(\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$",
          "description": "Stable dotted id whose first segment is the app, for example word.home.font.bold.",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            }
          ]
        },
        "app": {
          "enum": [
            "shell",
            "word",
            "excel",
            "powerpoint",
            "visio",
            "project",
            "outlook"
          ]
        },
        "kind": {
          "enum": [
            "tab",
            "contextualTab",
            "group",
            "control",
            "backstagePage",
            "pane",
            "statusItem",
            "view",
            "region",
            "dialog",
            "dialogTab",
            "setting",
            "contextMenu",
            "menuItem",
            "miniToolbar",
            "shortcut",
            "command"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noHost"
            }
          ],
          "description": "the visible label, at least one non-space character"
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "description": "id of the containing record",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "position among the parent's children"
        },
        "controlType": {
          "enum": [
            "button",
            "splitButton",
            "dropdown",
            "gallery",
            "galleryItem",
            "comboBox",
            "checkBox",
            "radioButton",
            "toggleButton",
            "spinner",
            "dialogLauncher",
            "menu",
            "dynamicMenu",
            "colorPicker",
            "editBox",
            "label",
            "separator",
            "box",
            "buttonGroup",
            "listBox",
            "slider"
          ]
        },
        "size": {
          "enum": [
            "large",
            "medium",
            "small"
          ]
        },
        "keytip": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noHost"
            }
          ],
          "pattern": "\\S"
        },
        "shortcut": {
          "type": "string",
          "minLength": 1,
          "description": "key chord, for example Ctrl+B, at least one non-space character",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noHost"
            }
          ],
          "pattern": "\\S"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "id of the command or control a shortcut invokes",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            }
          ]
        },
        "menuPath": {
          "type": "string",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noHost"
            }
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "description": "Pixels at 100 percent scaling, relative to the window client area.",
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "width": {
              "type": "integer",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "captureProfile": {
          "type": "string",
          "minLength": 1,
          "description": "profile id recorded in design/inventory/REFERENCE.md (checked by scripts/check-inventory.py)",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            }
          ]
        },
        "behaviour": {
          "type": "string",
          "minLength": 1,
          "description": "one sentence in our own words on what the element does; never quoted product text",
          "pattern": "^\\s*\\S",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noHost"
            }
          ]
        },
        "idMso": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            }
          ],
          "pattern": "\\S"
        },
        "uiaId": {
          "type": "string",
          "minLength": 1,
          "description": "the UI Automation id the capture read, kept even when the baseline does not list it",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            }
          ],
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "pattern": "^((uia|listcommands):[0-9]+(\\.[0-9]+){3}|baseline:[0-9a-f]{7,40})$",
          "description": "Capture provenance: uia: or listcommands: followed by the Office build, or baseline: followed by the baseline commit. Records never cite web pages.",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            }
          ]
        },
        "capturedFrom": {
          "type": "string",
          "minLength": 1,
          "description": "Office build recorded in design/inventory/REFERENCE.md, for example 16.0.20430.20182 (checked by scripts/check-inventory.py)",
          "allOf": [
            {
              "$ref": "#/$defs/noLink"
            },
            {
              "$ref": "#/$defs/noControl"
            }
          ]
        },
        "baselineMissing": {
          "type": "boolean",
          "description": "true when the live build shows it but the 2024 baseline lacks it"
        }
      },
      "dependentRequired": {
        "bounds": [
          "captureProfile"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "control"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "controlType",
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "shortcut"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "shortcut"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "pattern": "^(uia|listcommands):[0-9]+(\\.[0-9]+){3}$"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "capturedFrom"
            ]
          }
        }
      ]
    },
    "noLink": {
      "description": "Owner rule 2026-10-20: no record holds a web address. In every string field: a scheme followed by ://, a mailto: address, a www. name, a dotted host followed by a path, or a name ending in .com, .org, .net, .gov or .edu. Text a person reads is held to the stricter noHost rule as well.",
      "not": {
        "pattern": "[A-Za-z][A-Za-z0-9+.-]*://|[Ww][Ww][Ww]\\.|[Mm][Aa][Ii][Ll][Tt][Oo]:|[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+/|[A-Za-z0-9-]+\\.([Cc][Oo][Mm]|[Oo][Rr][Gg]|[Nn][Ee][Tt]|[Gg][Oo][Vv]|[Ee][Dd][Uu])(?![A-Za-z0-9-])",
        "description": "link"
      }
    },
    "noControl": {
      "description": "No C0 control character: a label is text someone can read.",
      "not": {
        "pattern": "[\\u0000-\\u001F]",
        "description": "control character"
      }
    },
    "noHost": {
      "description": "No address of any kind in text a person reads (label, keytip, shortcut, menuPath, behaviour). A full stop (., or the ideographic, fullwidth or halfwidth full stop that host names normalise to) may be followed only by whitespace, another full stop, closing punctuation, the end of the text, or a digit when a digit precedes it, as in a decimal such as 1.5. That refuses every host name, in any script and punycode included, whatever its letters. Four dotted numbers (an IPv4 address), three or more hexadecimal groups joined by colons (an IPv6 address, :: included) and a word followed directly by a colon, or a fullwidth colon, and a non-space character (any URI scheme) are refused too. Office's own labels have none of these; abbreviations with inner dots are refused as well, so write \"for example\", not \"e.g.\". Identifier fields carry noLink only, since ids are dotted and sources such as uia:16.0.20430.20182 carry a colon.",
      "not": {
        "pattern": "[.\\u3002\\uff0e\\uff61](?![\\s.\\u3002\\uff0e\\uff61)\\]\"'\\u201d\\u2019]|\\d|$)|(?<![0-9])[.\\u3002\\uff0e\\uff61](?=\\d)|\\d+[.\\u3002\\uff0e\\uff61]\\d+[.\\u3002\\uff0e\\uff61]\\d+[.\\u3002\\uff0e\\uff61]\\d+|[A-Za-z][A-Za-z0-9+.-]*[:\\uff1a]\\S|[0-9A-Fa-f]{0,4}(:[0-9A-Fa-f]{0,4}){2,}",
        "description": "host name or address"
      }
    }
  }
}
