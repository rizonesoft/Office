# Generated icon assets are compared byte for byte by scripts/build-icons.py --check, so checkout must not rewrite them.
design/icons/** text=auto eol=lf
assets/** text=auto eol=lf
design/github/** text=auto eol=lf
docs/assets/** text=auto eol=lf
*.png binary
*.ico binary
*.icns binary
# Baselines are compared byte for byte by scripts/import-office-ids.py --check.
design/inventory/** text=auto eol=lf
# Git hooks run under sh, which a CRLF shebang line breaks.
scripts/hooks/** text eol=lf
